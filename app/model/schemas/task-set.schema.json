{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://information-system-learning-app.local/schemas/task-set.schema.json",
  "title": "Task set",
  "type": "object",
  "required": ["id", "system_id", "name", "tasks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "system_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "levelCount": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "activity": { "type": "object" },
        "finish": { "type": "object" },
        "errorComponents": { "type": "array", "items": { "type": "object" } },
        "visiblePages": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  }
}
