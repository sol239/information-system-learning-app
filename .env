# Controls whether the app is in STUDENT or TEACHER mode.
# TEACHER enables teacher mode; every other value disables it.
NUXT_PUBLIC_APP_MODE=TEACHER

# Controls where default components are loaded from:
# public = system_components.json in the loaded system
# development = app/model/SystemComponents/**/*.ts
NUXT_PUBLIC_LOAD_COMPONENTS_FROM=public

# Controls where system pages are loaded from:
# public = .vue files in the loaded system
# development = static Nuxt pages in app/pages
NUXT_PUBLIC_LOAD_PAGES_FROM=development

# Controls which component editor code sections are visible.
NUXT_PUBLIC_HTML_AVAILABLE=true
NUXT_PUBLIC_CSS_AVAILABLE=true
NUXT_PUBLIC_JS_AVAILABLE=true
NUXT_PUBLIC_SQL_AVAILABLE=true
NUXT_PUBLIC_JS_CLICK_AVAILABLE=false
NUXT_PUBLIC_SQL_CLICK_AVAILABLE=true

# Controls whether student mode should be limited to a single system.
# When true (default), the app automatically navigates into the first available system.
# When false, the app displays the list of systems even in student mode.
NUXT_PUBLIC_SINGLE_SYSTEM=true
